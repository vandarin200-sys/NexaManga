# Neon Postgres: connection string dari dashboard Neon (Connection Details → Pooled/ connection string).
# Skema tabel nexamanga_snapshot dibuat otomatis pada request pertama.
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require"

# Telegram: hanya untuk penyimpanan gambar chapter/komentar, bukan katalog.
# Buat bot lewat @BotFather, lalu masukkan token bot tanpa membagikannya.
TELEGRAM_BOT_TOKEN="PASTE_BOTFATHER_TOKEN_HERE"
# Chat/channel/grup penyimpanan gambar. Tambahkan bot sebagai admin dengan izin kirim pesan.
TELEGRAM_STORAGE_CHAT_ID="-1001234567890"

# Aplikasi: isi juga variabel berikut di Vercel.
# Secret acak minimal 32 karakter; contoh generator ada di README.md.
TOKEN_SECRET="base64:3f7c1b2d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8g9h0i1j2k3l4m5n6o7p8q9r0s1t"
# URL HTTPS deployment Vercel, tanpa slash di akhir.
# Nilai ini HARUS sama dengan CONFIG.API_BASE_URL di nexamanga.xml.
PUBLIC_API_URL="https://nexamanga-nexamanga.vercel.app"
# Origin blog Blogger, misalnya https://nama-blog.blogspot.com
# Dipakai CORS dan return_to OAuth; harus match window.location.origin di Blogger.
ALLOWED_ORIGINS="https://x10think.blogspot.com"

# OAuth Google: buat OAuth Client ID tipe Web Application di Google Cloud.
GOOGLE_CLIENT_ID="GANTI_DENGAN_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="GANTI_DENGAN_GOOGLE_CLIENT_SECRET"
# Cloudflare R2 (opsional): penyimpanan gambar alternatif Telegram.
# Jika variabel R2 diisi lengkap, sistem otomatis memakai R2.
# Jika kosong, sistem otomatis memakai Telegram (jika token/chat id terisi).
R2_ACCOUNT_ID="GANTI_DENGAN_ACCOUNT_ID"
R2_ACCESS_KEY_ID="GANTI_DENGAN_ACCESS_KEY_ID"
R2_SECRET_ACCESS_KEY="GANTI_DENGAN_SECRET_ACCESS_KEY"
R2_BUCKET="nexamanga-images"
R2_PUBLIC_URL="https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev"

# Alternatif: isi variabel DB_HOST, DB_PORT, DB_NAME, DB_USER, DB_PASSWORD
# jika tidak menggunakan DATABASE_URL.
DB_HOST=""
DB_PORT=""
DB_NAME=""
DB_USER=""
DB_PASSWORD=""

